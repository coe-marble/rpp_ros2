<?xml version="1.0"?>
<package format="3">
  <name>rpp_ros2</name>
  <version>0.1.0</version>
  <description>Header-only C++ and Python ROS 2 helpers for RPP component lifecycles.</description>
  <maintainer email="luka.mandic@fer.hr">luka</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend version_gte="2.8.8">ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rpp_cpp</depend>
  <exec_depend>rpp_py</exec_depend>
  <exec_depend>rpp_plugin_registrator</exec_depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
